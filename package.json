{
  "name": "@enoughpower/dsh-git-graph",
  "version": "0.1.1",
  "description": "DeepSeek Harness 集成 Git 与文件浏览插件：宿主半提供 /git JSON API（status/branch/diff/stage/commit/log/blame/cat 等）与 /fs 文件 API（tree/read/write），浏览器半提供 Git 页签与文件浏览页签 UI。Integrated Git & file-browser plugin for DeepSeek Harness: host /git JSON API + /fs file API, browser Git tab + file-browser UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-git-graph",
    "summary": "集成 Git 状态/提交图/分支/差异/提交/推送拉取与文件浏览编辑一体化的 DeepSeek Harness 插件，界面中英双语。Git + file-browser plugin for DeepSeek Harness: status / commit graph / branches / diff / commit / push / pull plus file tree, preview and edit.",
    "categories": [
      "Git",
      "文件浏览",
      "Web UI"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "route:/git",
        "route:/fs"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=20"
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "git",
    "git-graph",
    "file-browser",
    "code-editor",
    "i18n",
    "bilingual",
    "zh",
    "en"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-settings-general": "*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
